---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCommissionerLedger, getPlayerMap } from '../../lib/data';

const entries = getCommissionerLedger();
const players = getPlayerMap();
const nameFor = (id: string) => players[id]?.full_name ?? id;
---
<BaseLayout title="Commissioner Ledger" description="Every commissioner-executed transaction, auto-logged from Sleeper. No model involvement.">
  <div class="container ledger-page">
    <h1>Commissioner Ledger</h1>
    <p class="dek">
      Every commissioner-executed transaction from Sleeper, logged automatically. Zero model involvement —
      this page is built straight off the transaction feed's <code>type</code> field, never written or
      summarized by a writer.
    </p>
    {entries.length === 0 && <p class="empty">No commissioner overrides logged this season.</p>}
    {entries.length > 0 && (
      <table>
        <thead>
          <tr><th>Date</th><th>Teams affected</th><th>Added</th><th>Dropped</th><th>Status</th></tr>
        </thead>
        <tbody>
          {entries.map((e) => (
            <tr>
              <td>{new Date(e.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
              <td>{e.teams_affected.join(', ')}</td>
              <td>{e.added_player_ids.map(nameFor).join(', ') || '—'}</td>
              <td>{e.dropped_player_ids.map(nameFor).join(', ') || '—'}</td>
              <td>{e.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</BaseLayout>

<style>
  .ledger-page { max-width: 900px; padding: var(--space-4) var(--space-3) var(--space-5); }
  .dek { color: var(--text-dim); max-width: 65ch; margin-bottom: var(--space-4); }
  .dek code { font-family: var(--font-ui); background: var(--surface); padding: 0 4px; }
  .empty { color: var(--text-dim); }
</style>
