---
interface Props {
  name: string;
  color: string;
  size?: number;
}
const { name, color, size = 40 } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
---
<span
  class="writer-avatar"
  style={`--size:${size}px; --avatar-color:${color}`}
  role="img"
  aria-label={name}
>{initials}</span>

<style>
  .writer-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    border-radius: var(--radius);
    background: var(--avatar-color);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: calc(var(--size) * 0.42);
    line-height: 1;
    flex-shrink: 0;
  }
</style>
