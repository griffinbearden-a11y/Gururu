---
interface Props {
  title: string;
  href?: string;
}
const { title, href } = Astro.props;
---
<section class="rail-module">
  <div class="rail-module-header">
    <h3 class="rail-module-title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
  </div>
  <div class="rail-module-body">
    <slot />
  </div>
</section>

<style>
  .rail-module {
    background: var(--surface);
    border: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }
  .rail-module-header {
    background: var(--red);
    padding: 8px var(--space-3);
  }
  .rail-module-body { padding: var(--space-3); }
  .rail-module-title {
    font-family: var(--font-ui-wide);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    margin: 0;
  }
  .rail-module-title a {
    color: inherit;
    text-decoration: none;
  }
  .rail-module-title a:hover { text-decoration: underline; }
</style>
