---
const links = [
  { href: '/', label: 'Home' },
  { href: '/wire/', label: 'The Wire' },
  { href: '/howlin-minute/', label: "Howlin' Minute" },
  { href: '/rankings/', label: 'Rankings' },
  { href: '/ledger/', label: 'Ledger' },
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---
<nav class="site-nav" aria-label="Primary">
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .site-nav a {
    font-family: var(--font-ui-wide);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    color: var(--text);
    text-decoration: none;
    padding: var(--space-1) 0;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { color: var(--red); }
  .site-nav a[aria-current='page'] { border-bottom-color: var(--red); color: var(--red); }
</style>
