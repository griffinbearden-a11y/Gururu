---
import Nameplate from '../components/Nameplate.astro';
import Footer from '../components/Footer.astro';
import SignupPopup from '../components/SignupPopup.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Macon's only dynasty fantasy football press corps." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — The Daily Guru</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="The Daily Guru" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nameplate />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SignupPopup />
  </body>
</html>
